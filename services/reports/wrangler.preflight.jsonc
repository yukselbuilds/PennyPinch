{
  "name": "pennypinch-reports-preflight",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "upload_source_maps": false,
  "observability": { "enabled": false },
  "vars": { "REPORTS_ENABLED": "false" },
  "d1_databases": [
    {
      "binding": "REPORTS_DB",
      "database_name": "pennypinch-reports-preflight",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "USAGE_RATE",
      "namespace_id": "47752001",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "triggers": { "crons": ["5 * * * *"] }
}
